  "program_identity": {
    "kode_prodi": "65201",
    "nama_prodi": "Ilmu Pemerintahan",
    "deskripsi_prodi": "Mengembangkan Keunggulan Ilmu Berbasis Smart Village, Kewirausahaan Digital dan Tata Kelola Pemerintahan Berdaya Saing Global (2045)",
    "visi_prodi": "Mengembangkan Keunggulan Ilmu Berbasis Smart Village, Kewirausahaan Digital dan Tata Kelola Pemerintahan Berdaya Saing Global (2045)",
    "misi_prodi": "Mengembangkan Keunggulan Ilmu Berbasis Smart Village, Kewirausahaan Digital dan Tata Kelola Pemerintahan Berdaya Saing Global (2045)",
    "gelar_lulusan": "S.I.P"
  },
  "identity": {
    "vision": "Unggul dalam pengembangan Ilmu Pemerintahan berbasis pemerintahan daerah dan desa, demokrasi lokal, serta transformasi pemerintah digital berlandaskan nilai Profesional Islami, berdampak pada pembangunan daerah, dan berorientasi global.",
    "distinctive": "Digital Local Government, Local Democracy, dan Smart Village Governance berbasis Profesional Islami.",
    "transversal_values": "Governmental Leadership, Integrity & AIK; Government Relations, Collaboration & Public Affairs; Research, Data & Evidence.",
    "degree": "S1",
    "level_kkni": 6,
    "total_credits": 144,
    "semesters": 8
  },
  "profiles": [
    {
      "code": "PL-01",
      "name": "Aparatur/Pengelola Pemerintahan Jenjang Pertama",
      "text": "Mampu menjalankan dan mengelola fungsi pemerintahan pada level awal/supervisi dengan memahami institusi, kewenangan, birokrasi, daerah/desa, pelayanan, data dan transformasi digital secara etis dan profesional Islami."
    },
    {
      "code": "PL-02",
      "name": "Analis/Konsultan Pemerintahan Jenjang Pertama",
      "text": "Mampu menganalisis masalah pemerintahan, institusi, politik-kebijakan, desentralisasi, pembangunan dan transformasi digital serta menyusun rekomendasi berbasis bukti."
    },
    {
      "code": "PL-03",
      "name": "Penggerak Masyarakat Sipil, Demokrasi Lokal & Pemberdayaan",
      "text": "Mampu memfasilitasi partisipasi, demokrasi lokal, advokasi, civic-tech, community governance dan pemberdayaan secara inklusif dan berbasis data."
    },
    {
      "code": "PL-04",
      "name": "Government Relations & Public Affairs Officer",
      "text": "Mampu membangun hubungan pemerintah-dunia usaha/organisasi, memahami regulasi/proses pemerintahan, melakukan komunikasi, negosiasi dan stakeholder management serta menjaga kepatuhan dan kepentingan publik."
    }
  ],
  "peo": [
    {
      "code": "PEO-01",
      "text": "Dalam 3-5 tahun setelah lulus, alumni menunjukkan kinerja profesional, berintegritas dan berorientasi kepentingan publik dalam penyelenggaraan pemerintahan, pelayanan, organisasi atau urusan pemerintahan pada level awal hingga supervisi.",
      "profiles": [
        "PL-01"
      ]
    },
    {
      "code": "PEO-02",
      "text": "Alumni mampu menggunakan pengetahuan Ilmu Pemerintahan, analisis institusi/politik-kebijakan dan evidence untuk memberikan rekomendasi atau solusi pada masalah pemerintahan daerah/desa, demokrasi, kelembagaan dan pembangunan.",
      "profiles": [
        "PL-02"
      ]
    },
    {
      "code": "PEO-03",
      "text": "Alumni mampu memprakarsai atau mendukung transformasi Pemerintah Digital, Smart Village Governance, civic-tech, inovasi pemerintahan dan partisipasi warga yang inklusif serta berdampak.",
      "profiles": [
        "PL-03"
      ]
    },
    {
      "code": "PEO-04",
      "text": "Alumni menunjukkan kepemimpinan berkemajuan, nilai Profesional Islami, kemampuan komunikasi/negosiasi/jejaring, government relations, pembelajaran sepanjang hayat dan orientasi global.",
      "profiles": [
        "PL-04"
      ]
    }
  ],
  "cpl": [
    {
      "code": "CPL-01",
      "text": "Mampu bertindak profesional, amanah, berintegritas, bertanggung jawab, taat hukum, menghargai kemanusiaan dan keberagaman, serta menginternalisasikan nilai Al-Islam dan Kemuhammadiyahan dalam penyelenggaraan dan relasi pemerintahan.",
      "profiles": [
        "PL-01",
        "PL-03",
        "PL-04"
      ]
    },
    {
      "code": "CPL-02",
      "text": "Mampu menguasai dan menerapkan konsep, teori, sistem, institusi, kewenangan, birokrasi dan proses governing untuk menjelaskan serta menganalisis penyelenggaraan pemerintahan secara sistematis.",
      "profiles": [
        "PL-01",
        "PL-02"
      ]
    },
    {
      "code": "CPL-03",
      "text": "Mampu menganalisis kekuasaan, aktor, institusi politik, sistem politik, demokrasi, pemilu, representasi, komunikasi politik dan dinamika sosial-politik yang memengaruhi proses pemerintahan secara kritis dan berbasis bukti.",
      "profiles": [
        "PL-02",
        "PL-03"
      ]
    },
    {
      "code": "CPL-04",
      "text": "Mampu menganalisis dan merancang penguatan pemerintahan daerah/desa, hubungan antarpemerintahan, desentralisasi, demokrasi lokal, pembangunan dan Smart Village Governance sesuai kewenangan, konteks, partisipasi dan prinsip akuntabilitas.",
      "profiles": [
        "PL-01",
        "PL-02",
        "PL-03"
      ]
    },
    {
      "code": "CPL-05",
      "text": "Mampu menganalisis proses kebijakan dan regulasi, perencanaan pembangunan, kepentingan, implementasi, evaluasi serta implikasi hukum-kewenangan untuk menyusun alternatif/rekomendasi penyelenggaraan pemerintahan yang dapat dipertanggungjawabkan.",
      "profiles": [
        "PL-02",
        "PL-04"
      ]
    },
    {
      "code": "CPL-06",
      "text": "Mampu mengelola dan mengevaluasi birokrasi, ASN, sumber daya, keuangan, kinerja, pengawasan, akuntabilitas dan pelayanan pemerintahan secara efektif, etis, adaptif dan berorientasi pada warga.",
      "profiles": [
        "PL-01"
      ]
    },
    {
      "code": "CPL-07",
      "text": "Mampu memanfaatkan data, teknologi digital dan kecerdasan artifisial secara etis untuk analitika pemerintahan, transformasi Pemerintah Digital, tata kelola data/interoperabilitas, keamanan dan privasi, Smart Village, serta partisipasi/demokrasi digital.",
      "profiles": [
        "PL-01",
        "PL-02",
        "PL-03",
        "PL-04"
      ]
    },
    {
      "code": "CPL-08",
      "text": "Mampu berkomunikasi, bernegosiasi, memfasilitasi partisipasi, mengelola pemangku kepentingan, membangun government relations/public affairs dan kolaborasi pemerintah-masyarakat-dunia usaha secara inklusif, etis dan berorientasi kepentingan publik.",
      "profiles": [
        "PL-01",
        "PL-02",
        "PL-03",
        "PL-04"
      ]
    },
    {
      "code": "CPL-09",
      "text": "Mampu menerapkan metode penelitian, statistik dan analitika data untuk menghasilkan informasi/temuan yang sahih, mengelola data secara bertanggung jawab, serta menyajikan karya ilmiah dan rekomendasi berbasis bukti secara tertulis maupun lisan.",
      "profiles": [
        "PL-02",
        "PL-03"
      ]
    },
    {
      "code": "CPL-10",
      "text": "Mampu memimpin dan mengambil keputusan, merancang serta mengimplementasikan inovasi pemerintahan, kewirausahaan sosial-digital, community/government project dan solusi kolaboratif yang menciptakan public/social value dan dampak pembangunan daerah/desa.",
      "profiles": [
        "PL-01",
        "PL-03",
        "PL-04"
      ]
    }
  ],
